# Local Docker Compose development settings. Fill locally; do not commit docker/.env.
NODE_ENV=development
MYSQL_ROOT_PASSWORD=
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
# Comma-separated exact origins. Replace the LAN example with the address used by your network.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://192.168.1.83:3000
PORT=3001
