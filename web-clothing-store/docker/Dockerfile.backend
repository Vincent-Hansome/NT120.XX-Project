FROM node:24-alpine

ENV NODE_ENV=production

WORKDIR /app

COPY --chown=node:node backend/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node backend/ ./

RUN mkdir -p /app/uploads \
    && chown -R node:node /app/uploads

USER node

EXPOSE 3001

CMD ["npm", "start"]